rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    //                  دوال مساعدة عامة
    // =====================================================

    // هل المستخدم مسجّل دخول أصلاً؟
    function isSignedIn() {
      return request.auth != null;
    }

    // هل هو حساب الأدمن الوحيد المصرّح له بلوحة الإدارة؟
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "ahmedkhalil7749000@gmail.com";
    }

    // وسوم "سفرة العافية" على أصناف المنيو: إما غير موجودة، أو قائمة (حتى 8 عناصر)
    // كل عناصرها من القيم المسموحة فقط (نفس القيم بالملف care-tags.js)
    function validCareTags(data) {
      return !('careTags' in data)
             || (data.careTags is list
                 && data.careTags.size() <= 8
                 && data.careTags.hasOnly(["نفاس", "مريض", "كبار السن", "قليل الملح", "بدون سكر مضاف", "سهل الهضم", "بدون قلي"]));
    }

    // =====================================================
    //                  users/{userId}
    // =====================================================
    match /users/{userId} {
      // كل مستخدم يقرأ وثيقته الخاصة فقط، والأدمن يقدر يقرأ أي وثيقة
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // الإنشاء وقت التسجيل: بس صاحب الحساب نفسه، وبشرط تكون قيمة role صحيحة ومسموحة
      // (الأدمن مستثنى من شرط role عشان يقدر ينشئ/يحدّث وثيقته الخاصة بتوكن
      // الإشعارات fcmToken حتى لو ما عندها role أصلاً)
      allow create: if (isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role in ["customer", "restaurant_owner"])
                    || isAdmin();

      // التعديل: بس صاحب الحساب، وممنوع يغيّر حقل role بنفسه (حماية من ترقية صلاحياته).
      // استثناء: لو الوثيقة أصلاً ناقصها role (حساب قديم أو غير مكتمل)، مسموح
      // يحطها لأول مرة (بس مو يغيّرها لو كانت موجودة أصلاً).
      // ملاحظة أمنية: لما الوثيقة ناقصها role، لازم تبقى القيمة الجديدة ضمن
      // القيم المسموحة فقط — بدون هالشرط أي حساب قديم بيقدر يعطي حاله
      // role: 'admin' بنفسه.
      allow update: if (isSignedIn() && request.auth.uid == userId
                    && (request.resource.data.role == resource.data.role
                        || (!('role' in resource.data)
                            && request.resource.data.role in ["customer", "restaurant_owner"])))
                    || isAdmin();

      // الحذف: غير مسموح من الواجهة إطلاقاً (فقط عبر Firebase Console يدويًا)
      allow delete: if false;
    }

    // =====================================================
    //                  restaurants/{restaurantId}
    // =====================================================
    match /restaurants/{restaurantId} {
      // القراءة عامة للجميع (حتى الزوار غير المسجلين) عشان صفحة عرض المطاعم تشتغل
      allow read: if true;

      // الإنشاء: فقط مستخدم مسجل دخول، ويجب أن يربط ownerEmail ببريده هو نفسه
      allow create: if isSignedIn()
                    && request.resource.data.ownerEmail == request.auth.token.email;

      // التعديل: صاحب المطعم أو الأدمن يقدروا يعدلوا أي حقل.
      // أي مستخدم مسجل دخول (زبون) مسموح له يعدّل فقط rating و reviewsCount،
      // وبشرط تكون القيم صحيحة النوع وضمن حدود منطقية
      // (إصلاح: قبل كذا كان أي شخص يقدر يحط أي رقم عشوائي بدون تحقق)
      //
      // ملاحظة (نظام البانر والفيديو): صاحب المطعم يقدر يرفع/يغيّر bannerUrl
      // و videoUrl بحرية (هاي "الطلب" منه)، لكن ممنوع عليه يحط بنفسه
      // bannerStatus أو videoStatus = "معتمد" — هاي الكلمة محجوزة للأدمن فقط
      // (هو يقدر يحطها "قيد المراجعة" لما يرفع محتوى جديد، وبس). هيك ضمان
      // حقيقي (مو بس بالواجهة) إن أي بانر/فيديو ما يظهر عالصفحة الرئيسية
      // إلا بعد موافقة الأدمن الفعلية.
      allow update: if isAdmin()
                    || (
                      isSignedIn() && resource.data.ownerEmail == request.auth.token.email
                      && (
                        !('bannerStatus' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.bannerStatus == "قيد المراجعة"
                      )
                      && (
                        !('videoStatus' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.videoStatus == "قيد المراجعة"
                      )
                    )
                    || (
                      isSignedIn()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewsCount'])
                      && request.resource.data.rating is number
                      && request.resource.data.rating >= 0
                      && request.resource.data.rating <= 5
                      && request.resource.data.reviewsCount is int
                      && request.resource.data.reviewsCount >= 0
                    )
                    // أي زبون مسجل دخول يقدر يحدّث عداد إعجابات فيديو المطعم فقط
                    // (الرقم نفسه محسوب ومتحقق منه بالكود من عدد وثائق videoLikes الحقيقية)
                    || (
                      isSignedIn()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['videoLikesCount'])
                      && request.resource.data.videoLikesCount is int
                      && request.resource.data.videoLikesCount >= 0
                    )
                    // أي زبون مسجل دخول يقدر يحدّث متوسط/عدد تقييمات فيديو المطعم فقط
                    || (
                      isSignedIn()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['videoRating', 'videoRatingsCount'])
                      && request.resource.data.videoRating is number
                      && request.resource.data.videoRating >= 0
                      && request.resource.data.videoRating <= 5
                      && request.resource.data.videoRatingsCount is int
                      && request.resource.data.videoRatingsCount >= 0
                    );

      // الحذف: فقط صاحب هذا المطعم بالذات، أو الأدمن
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.ownerEmail == request.auth.token.email);
    }

    // =====================================================
    //                  menuItems/{itemId}
    // =====================================================
    match /menuItems/{itemId} {
      // القراءة عامة (المنيو لازم يظهر لكل الزوار والزبائن)
      allow read: if true;

      // الإنشاء: صاحب المطعم المرتبط بالصنف، أو الأدمن (يقدر يضيف أصناف لأي مطعم مباشرة)
      allow create: if validCareTags(request.resource.data)
                    && (
                      isAdmin()
                      || (isSignedIn()
                          && get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.ownerEmail == request.auth.token.email)
                    );

      // التعديل: فقط صاحب المطعم يلي الصنف تابع له، أو الأدمن.
      // إصلاح: أضفنا شرط يمنع تغيير restaurantId أثناء التعديل، عشان صاحب مطعم
      // ما يقدر "ينقل" صنف لمطعم ثاني مو ملكه (كانت ثغرة تسمح بزرع أصناف مزوّرة).
      allow update: if isAdmin()
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)).data.ownerEmail == request.auth.token.email
                        && request.resource.data.restaurantId == resource.data.restaurantId
                        && validCareTags(request.resource.data));

      // الحذف: فقط صاحب المطعم يلي الصنف تابع له، أو الأدمن
      allow delete: if isAdmin()
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)).data.ownerEmail == request.auth.token.email);
    }

    // =====================================================
    //                  reviews/{reviewId}
    // =====================================================
    match /reviews/{reviewId} {
      // القراءة عامة للجميع عشان الكل يشوف تقييمات المطعم قبل ما يطلب
      allow read: if true;

      // الإنشاء: بس مستخدم مسجل دخول، وبشرط يربط customerId بحسابه هو، وتقييم بين 1 و5
      allow create: if isSignedIn()
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      // التعديل والحذف: بس صاحب التقييم نفسه، أو الأدمن
      allow update, delete: if isAdmin()
                    || (isSignedIn() && resource.data.customerId == request.auth.uid);
    }

    // =====================================================
    //                  videoLikes/{likeId}
    //   likeId لازم يكون بالشكل: {restaurantId}_{uid} — هيك
    //   نضمن زبون واحد ما يقدر يعمل أكتر من إعجاب لنفس الفيديو
    //   (بدل ما نعتمد على تحقق بالواجهة بس)
    // =====================================================
    match /videoLikes/{likeId} {
      // القراءة عامة (عشان أي زائر يشوف عدد الإعجابات)
      allow read: if true;

      // الإنشاء: بس مستخدم مسجل دخول، ومعرف الوثيقة لازم يطابق restaurantId_uid تبعه
      allow create: if isSignedIn()
                    && request.resource.data.customerId == request.auth.uid
                    && likeId == request.resource.data.restaurantId + '_' + request.auth.uid;

      // الحذف (لإلغاء الإعجاب): بس صاحب الإعجاب نفسه، أو الأدمن
      allow update: if false;
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.customerId == request.auth.uid);
    }

    // =====================================================
    //                  videoRatings/{ratingId}
    //   ratingId لازم يكون بالشكل: {restaurantId}_{uid} — هيك
    //   الزبون بيقدر يعدّل تقييمه بس ما بيقدر يعمل أكتر من تقييم
    // =====================================================
    match /videoRatings/{ratingId} {
      // القراءة عامة (عشان أي زائر يشوف متوسط التقييم)
      allow read: if true;

      // الإنشاء والتعديل: بس مستخدم مسجل دخول، معرف الوثيقة يطابق حسابه،
      // وتقييم صحيح بين 1 و5
      allow create, update: if isSignedIn()
                    && request.resource.data.customerId == request.auth.uid
                    && ratingId == request.resource.data.restaurantId + '_' + request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      // الحذف: بس صاحب التقييم نفسه، أو الأدمن
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.customerId == request.auth.uid);
    }

    // =====================================================
    //                  orders/{orderId}
    // =====================================================
    match /orders/{orderId} {
      // الإنشاء: ممنوع تمامًا من المتصفح مباشرة. كل طلب لازم يتم إنشاؤه
      // عبر Cloud Function الموثوقة createOrder (functions/index.js) يلي
      // بتحسب السعر من menuItems على السيرفر وتتحقق من كل شي، وبتكتب
      // الوثيقة عبر Admin SDK يلي بيتخطى هالقواعد أصلًا. هيك ما في طريقة
      // للعميل يزوّر سعر/كمية/مطعم الطلب حتى لو عدّل الطلب من أدوات المطوّر.
      allow create: if false;

      // القراءة: الأدمن، أو الزبون صاحب الطلب (بأي من الحقلين)، أو صاحب المطعم المرتبط بالطلب
      allow read: if isAdmin()
                  || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid))
                  || (isSignedIn()
                      && get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)).data.ownerEmail == request.auth.token.email);

      // التعديل: الأدمن يقدر يعدّل أي شيء بالطلب.
      // إصلاح: صاحب المطعم كان مسموح له يعدّل أي حقل بالطلب (حتى السعر وبيانات الزبون!).
      // الآن مقيّد فقط بتحديث حالة الطلب، سبب الرفض، طريقة الاستلام (استلام ذاتي دائماً)
      // ووقت التسليم المتوقع.
      allow update: if isAdmin()
                  || (isSignedIn()
                      && get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)).data.ownerEmail == request.auth.token.email
                      && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'rejectionReason', 'deliveryMethod', 'estimatedDeliveryTime', 'scheduleNotified', 'updatedAt']));

      // الحذف: الأدمن فقط
      allow delete: if isAdmin();
    }

    // =====================================================
    //                  carts/{uid}  (سلة كل مستخدم مسجّل)
    // =====================================================
    match /carts/{uid} {
      // كل مستخدم يقرأ ويكتب على سلته هو بس (وثيقة السلة معرّفها = uid صاحبها)
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // =====================================================
    //          subscriptionPlans/{planId}  (خطط الاشتراك)
    // =====================================================
    match /subscriptionPlans/{planId} {
      // أي مستخدم مسجل دخول يقدر يشوف الخطط المتاحة (عشان صفحة الاشتراك تشتغل)
      allow read: if isSignedIn();

      // الإنشاء / التعديل / الحذف: الأدمن فقط
      allow write: if isAdmin();
    }

    // =====================================================
    //          subscriptions/{subscriptionId}  (طلبات/سجل الاشتراك)
    // =====================================================
    match /subscriptions/{subscriptionId} {
      // القراءة: الأدمن يشوف الكل، وصاحب المطعم يشوف طلباته هو بس
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      // الإنشاء: صاحب المطعم يقدر يفتح طلب اشتراك جديد لنفسه فقط،
      // ولازم يبدأ الطلب بحالة "قيد المراجعة"
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == "قيد المراجعة";

      // التعديل:
      // 1) الأدمن يقدر يعدّل أي شي (موافقة/رفض/توليد كود/إنهاء الاشتراك)
      // 2) صاحب المطعم يقدر يفعّل اشتراكه بنفسه فقط لما يدخل كود التفعيل الصحيح
      //    اللي ولّده الأدمن (لازم يطابق تمامًا activationCode المخزّن بالطلب)
      allow update: if isAdmin()
                    || (
                      isSignedIn()
                      && resource.data.ownerUid == request.auth.uid
                      && resource.data.status == "بانتظار كود التفعيل"
                      && request.resource.data.status == "نشط"
                      && resource.data.activationCode != null
                      && request.resource.data.enteredCode == resource.data.activationCode
                      && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'enteredCode', 'startDate', 'endDate', 'activatedAt'])
                    );

      // الحذف: الأدمن فقط
      allow delete: if isAdmin();
    }

    // =====================================================
    //          platformAds/{adId}  (إعلانات المنصة — بانر/فيديو)
    //          مستقلة كليًا عن اشتراكات المطاعم، يتحكم بها الأدمن فقط
    // =====================================================
    match /platformAds/{adId} {
      // القراءة عامة للجميع (حتى الزوار غير المسجلين) عشان تظهر
      // بالصفحة الرئيسية وصفحة كل مطعم
      allow read: if true;

      // الإنشاء / التعديل / الحذف: الأدمن فقط
      allow write: if isAdmin();
    }

    // =====================================================
    //          heroDishes/{dishId}  (صور الدائرة المتحركة بأول الرئيسية)
    //          siteSettings/{docId} (إعدادات عامة، مثل سرعة التبديل)
    //          القراءة للجميع، والكتابة للأدمن فقط
    // =====================================================
    match /heroDishes/{dishId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
